%% test.sys.config: the 12.x test environment.
%%
%% Loaded by every `rebar3 eunit' run (see the test profile in rebar.config).
%% The suites never start macula, but this keeps the VM honest for the
%% suites that do.
[
    {kernel, [{logger_level, warning}]},
    %% NO `puzzle_difficulty' HERE. macula 12 (D30) makes it one constant for
    %% the fleet and REFUSES a per-node setting.
    {macula, [
        {node_identity_path, "_build/test/node_identity.key"},
        {crypto_profile, pq_hybrid}
    ]}
].
