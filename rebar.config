%% -*- mode: erlang -*-
%% rebar3 configuration for mcl-bookclub-observer -- the consumer half of
%% the bookclub's facts.
%%
%% STORELESS, DELIBERATELY. This service owns no reckon-db store and never
%% dispatches a command: it consumes mesh facts and answers questions about
%% what it saw. That boundary is the dependency list itself -- there is no
%% evoq or reckon dep to import, so a stray evoq call cannot compile.
{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities,
    %% health, and the declarative subscriptions/0 wiring.
    {mcl_om, "~> 0.28"},
    %% The read model: one sqlite file this service writes and reads.
    {esqlite, "~> 0.9"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% The mesh SDK comes in only through mcl_om; both would be "unknown" to the
%% PLT without naming them here.
{dialyzer, [
    {warnings, [no_unknown]},
    {plt_extra_apps, [mcl_om, macula, esqlite]}
]}.

{relx, [
    {release, {mcl_bookclub_observer, "0.1.0"},
     [mcl_bookclub_observer, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {test, [
        %% meck stands in for the mesh in the scoreboard verification test.
        {deps, [{meck, "~> 1.2"}]},
        {eunit_opts, [{sys_config, "./config/test.sys.config"}]}
    ]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
